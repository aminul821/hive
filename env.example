# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub — add ".env" to .gitignore

HIVETRUST_SECRET_KEY=change-this-to-a-random-string
FLASK_ENV=development

# --- Blockchain (HoneyLedger on Ethereum Sepolia testnet) ---
INFURA_SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
HONEYCHAIN_PRIVATE_KEY=your_metamask_private_key_here
HONEYLEDGER_CONTRACT_ADDRESS=0x6000503Adf4402413E48b12169587a4b36200010

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> "Session pooler" -> copy the URI.
# Use SESSION POOLER (port 5432), NOT "Direct connection": on the free
# tier the direct host is IPv6-only and Render/Railway are IPv4-only,
# so it fails with "Network is unreachable".
# Leave unset locally to fall back to a SQLite file.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# --- Optional: authenticate hardware sensor ingest ---
# DEVICE_INGEST_KEY=some-long-random-string
